{
  "name": "valhalla-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "desktop": "cross-env NODE_ENV=development electron .",
    "build:exe": "npm run build && electron-builder --win",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "build": {
    "appId": "com.valhalla.soc",
    "productName": "Valhalla SOC",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "files": [
      "app/dist/**/*",
      "electron-main.js"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@mui/icons-material": "^6.4.6",
    "@mui/material": "^6.4.6",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/leaflet": "^1.9.21",
    "dompurify": "^3.4.2",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^2.2.3",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  }
}
