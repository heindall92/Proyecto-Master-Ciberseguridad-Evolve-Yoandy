# ═══════════════════════════════════════════════════════════════════════════════
# Valhalla SOC — Variables de Entorno
#
# PRIMER ARRANQUE (recomendado): no copie este archivo a mano.
#   Windows:  setup.bat  o  Valhalla-Runner.bat
#   Linux:    ./scripts/setup_env.sh
#   Make:     make setup
# El asistente genera .env con SECRET_KEY, WEBHOOK_SECRET y ADMIN_PASSWORD.
# NUNCA subir .env a Git
# ═══════════════════════════════════════════════════════════════════════════════

# ── Backend FastAPI ───────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-min-32-chars
# Mín. 12 caracteres, mayúsc/minúsc/número (validado al crear admin)
ADMIN_PASSWORD=change-me-strong-admin-password-min-16-chars
# Mismo valor en Wazuh manager (env WEBHOOK_SECRET) y cabecera X-Valhalla-Webhook-Token
WEBHOOK_SECRET=change-me-webhook-token-for-wazuh-integration-min-24-chars
DATABASE_URL=postgresql+psycopg://valhalla:valhalla@postgres:5432/valhalla
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost:8443
BACKEND_PORT=8000

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Entrega limpia: sin tickets automáticos desde Wazuh hasta que el analista sincronice
AUTO_SYNC_WAZUH_TICKETS=false
AUTO_CREATE_WEBHOOK_TICKETS=false

# Cookies (http://localhost → false; detrás de HTTPS en prod → true)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Producción: ENV=production exige SECRET_KEY (32+), WEBHOOK_SECRET (24+), SESSION_COOKIE_SECURE=true
# Postgres/OpenSearch NO se publican al host por defecto. Solo dev:
#   docker compose -f docker-compose.yml -f docker-compose.dev-expose.yml up -d

# Frontend: modo offline demo DESACTIVADO por defecto (solo dev explícito)
VITE_ALLOW_OFFLINE_DEMO=false

# ── Wazuh Manager API ────────────────────────────────────────────────────────
WAZUH_API_URL=https://wazuh.manager:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=replace-with-real-pass

# ── OpenSearch / Wazuh Indexer ────────────────────────────────────────────────
OPENSEARCH_URL=https://wazuh.indexer:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=replace-with-real-pass
# TLS hacia Wazuh/OpenSearch: false en lab (certs autofirmados); true en producción
TLS_VERIFY_SSL=false
# TLS_CA_BUNDLE=/ruta/a/ca-wazuh.pem
INDEXER_USERNAME=admin
INDEXER_PASSWORD=replace-with-real-pass

# ── Wazuh Dashboard ──────────────────────────────────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-with-real-pass
OPENSEARCH_DASHBOARDS_USER=kibanaserver
WAZUH_DASHBOARD_URL=https://localhost

# ── Ollama (IA Local) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_LIGHT_MODEL=qwen2.5:3b-instruct
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT_SECONDS=45

# ── Threat Intelligence ──────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=
OTX_API_KEY=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=valhalla
POSTGRES_USER=valhalla
POSTGRES_PASSWORD=replace-with-real-pass
POSTGRES_PORT=5432

# ── React Dashboard ──────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
VITE_API_BASE_URL=

# ── Gateway HTTPS (VM exposición: docker compose --profile prod up -d) ───────
GATEWAY_HTTP_PORT=8080
GATEWAY_HTTPS_PORT=8443

# ── Security Settings ────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
EVIDENCE_DIR=/app/uploads/evidence
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_VT=10/minute
RATE_LIMIT_THREAT_MAP=6/minute
GEO_CACHE_TTL_DAYS=30
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
CSRF_ENABLED=true

# ── Acceso remoto por VPN (Tailscale, opcional) ─────────────────────────
# Arranque del puente de identidad: docker compose --profile tailscale up -d
# HTTPS: activa "HTTPS Certificates" en login.tailscale.com/admin/dns y ejecuta en el host
#   sudo tailscale serve --bg --https=443 http://127.0.0.1:3000
#   sudo tailscale set --snat-subnet-routes=false   (si no, Valhalla ve la IP de Docker y no la del móvil)
#   scripts/vpn-firewall.sh (+ servicio valhalla-vpn-firewall): desde la VPN solo HTTPS, sin http ni puertos de Docker
# Dirección que se envía en las invitaciones (vacío = IP de Tailscale del host).
VALHALLA_PUBLIC_URL=
# Clave de API (login.tailscale.com/admin/settings/keys, caduca en ≤90 días) para que el botón
# "Invitar" genere el enlace que comparte SOLO esta máquina. Vacío = compartir a mano.
TAILSCALE_API_KEY=
